# Maintainer: RidgetopAi <backstory@ridgetop.ai>
#
# `.SRCINFO` is generated, not hand-edited: after bumping `pkgver` here, run
#   makepkg --printsrcinfo > .SRCINFO
# from this directory and commit both files together. This PKGBUILD is not
# pushed to the AUR by anything in this repo or its CI — that push, like
# marketplace submission, requires Brian's explicit approval (see
# RELEASING.md). `make release-check` only validates this file locally; it
# builds nothing and publishes nothing.
pkgname=backstory
pkgver=1.3.0
pkgrel=1
pkgdesc="OS memory daemon for Omarchy: systemd --user service, SQLite/FTS5 store, unix socket + MCP stdio shim"
arch=('x86_64')
url="https://github.com/RidgetopAi/backstory"
license=('MIT')
depends=('glibc')
makedepends=('go')
install=backstory.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/RidgetopAi/backstory/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8512c7c32b695b3e136d0c4e525e4869cd8b3f438cab7b8e7931005432251aa1')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -trimpath \
		-ldflags "-s -w -X github.com/RidgetopAi/backstory/internal/version.Version=v$pkgver" \
		-o bin/backstory \
		./cmd/backstory
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 bin/backstory "$pkgdir/usr/bin/backstory"
	# The in-repo units run the `make install` binary (%h/.local/bin); the
	# package's binary is /usr/bin/backstory, so the installed copies are
	# rewritten. ops/ itself is left alone (make install uses it as-is).
	local unit
	for unit in backstory.service backstory-sync.service; do
		install -Dm644 "ops/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
		sed -i 's|^ExecStart=%h/\.local/bin/backstory |ExecStart=/usr/bin/backstory |' "$pkgdir/usr/lib/systemd/user/$unit"
	done
	install -Dm644 ops/backstory-sync.timer "$pkgdir/usr/lib/systemd/user/backstory-sync.timer"
	install -Dm644 ops/hyprland/backstory.lua "$pkgdir/usr/share/backstory/hyprland/backstory.lua"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
